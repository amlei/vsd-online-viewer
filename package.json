{
  "name": "vsd-online-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Upload, convert and view Microsoft Visio (.vsd) drawings in the browser",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build:renderer": "./renderer/build.sh",
    "start": "bun run server/server.mjs",
    "dev": "bun --watch server/server.mjs",
    "test": "bun test",
    "census": "python3 renderer/tools/census.py"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
